POSTGRES_USER=rrhh_user
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=rrhh_motor

# --- IA (la narrativa SIEMPRE la redacta un modelo; no hay plantilla) ---
# MODO_DATOS: "reales" (por defecto) bloquea cualquier proveedor en la nube.
# Pon "sinteticos" SOLO si la base tiene datos de prueba (scripts/seed.py).
MODO_DATOS=reales

# LLM_PROVEEDOR: ollama (local, unico permitido con datos reales) | groq (nube)
LLM_PROVEEDOR=ollama
LLM_INTENTOS=3            # intentos con correccion por cada ronda
NARRATIVA_RONDAS=2        # rondas desde cero si el modelo no pasa los guardarrailes

# Ollama (local, en tu equipo)
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=900        # segundos; en CPU un reporte tarda minutos
OLLAMA_NUM_CTX=8192       # 4096 se rebasaba en los reintentos

# Groq (nube, gratis sin tarjeta: console.groq.com/keys). Solo con MODO_DATOS=sinteticos.
# Activa "Zero Data Retention" en console.groq.com > Settings > Data Controls.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Sesion (paso 6) ---
# Secreto para firmar los tokens de sesion: minimo 32 caracteres, unico por
# instalacion y nunca en el repositorio. Generalo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=
JWT_MINUTOS=60            # duracion de la sesion

# --- Reportes exportados (paso 9) ---
# Zona horaria de las fechas en el PDF y la presentacion.
ZONA_HORARIA=America/Mexico_City

# --- Base de datos en la nube (Supabase) ---
# Si DATABASE_URL tiene valor, se usa en lugar del PostgreSQL local de Docker.
# En Supabase: boton "Connect" > "Session pooler" (funciona en redes IPv4).
# Cambia [YOUR-PASSWORD] por la contrasena de la base. SSL se activa solo.
# Las pruebas (pytest) se niegan a correr contra una base remota.
# DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
