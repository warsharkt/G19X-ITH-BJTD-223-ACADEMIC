# Para la demostracion con Docker basta con cambiar tres lineas:
#   POSTGRES_PASSWORD (aqui abajo), MODO_DATOS=sinteticos y MODO_DEMO=si.
# Luego: docker compose up -d --build  y abre http://localhost:8080

POSTGRES_USER=rrhh_user
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=rrhh_motor
# Opcional: donde escucha el PostgreSQL local (docker-compose.yml publica el 5433)
# DB_HOST=localhost
# DB_PORT=5433
# Desde donde aceptan conexiones la base, la API y el tablero de Docker. Por
# defecto solo desde este mismo equipo; cambialo solo si de verdad hace falta.
# DB_ESCUCHA=127.0.0.1
# API_ESCUCHA=127.0.0.1
# WEB_ESCUCHA=127.0.0.1
# HTTPS del tablero: auto (por defecto) lo activa en cuanto WEB_ESCUCHA abre el
# tablero a la red; si = siempre; no = nunca (se niega si esta abierto a la red).
# Certificado de la empresa en certs/talentia.crt y certs/talentia.key; si no
# hay, se genera uno autofirmado para WEB_NOMBRE. Con HTTPS, APP_URL debe ser
# la direccion https (por ejemplo https://192.168.1.20:8443).
# WEB_HTTPS=auto
# WEB_NOMBRE=localhost
# WEB_PUERTO_HTTPS=8443

# --- IA (la narrativa SIEMPRE la redacta un modelo; no hay plantilla) ---
# MODO_DATOS: "reales" (por defecto) bloquea cualquier proveedor en la nube.
# Pon "sinteticos" SOLO si la base tiene datos de prueba (scripts/seed.py).
MODO_DATOS=reales

# LLM_PROVEEDOR: ollama (local, unico permitido con datos reales) | groq (nube)
LLM_PROVEEDOR=ollama
LLM_INTENTOS=3            # intentos con correccion por cada ronda
NARRATIVA_RONDAS=2        # rondas desde cero si el modelo no pasa los guardarrailes

# Ollama (local, en tu equipo)
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=900        # segundos; en CPU un reporte tarda minutos
OLLAMA_NUM_CTX=8192       # 4096 se rebasaba en los reintentos
# OLLAMA_URL=http://localhost:11434   # si Ollama corre en otro equipo de la red
# (con Docker, la API llega al Ollama de este equipo por host.docker.internal)

# Groq (nube, gratis sin tarjeta: console.groq.com/keys). Solo con MODO_DATOS=sinteticos.
# Activa "Zero Data Retention" en console.groq.com > Settings > Data Controls.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Sesion (paso 6) ---
# Secreto para firmar los tokens de sesion: minimo 32 caracteres, unico por
# instalacion y nunca en el repositorio. Generalo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Con Docker, si lo dejas vacio se genera uno temporal en cada arranque (las
# sesiones se cierran al reiniciar).
JWT_SECRETO=
JWT_MINUTOS=60            # duracion de la sesion
# Roles que deben usar verificacion en dos pasos (app de autenticacion en el
# telefono). Los demas pueden activarla si quieren. No lo vacies con datos reales.
MFA_OBLIGATORIO=direccion,admin_ti,rrhh
# Llave que cifra el secreto del MFA de cada cuenta (AES-256). Si la dejas vacia
# se genera sola la primera vez en llaves/mfa.key. Respaldala APARTE de la base:
# si se pierde, TI tiene que reiniciar la verificacion en dos pasos de todos.
# Para fijarla:
#   python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MFA_LLAVE=

# --- Empresa y modo demostracion ---
# Nombre de la empresa que usa Talentia Insights (aparece en la pantalla de
# inicio, el menu y los reportes). Viene instalado para Nordika Logistica.
EMPRESA_NOMBRE=Nordika Logística

# Con MODO_DEMO=si se crean las cuentas del personal de Nordika (eva.munoz,
# ana.rios, andrea.salinas, luis.ortega, carlos.pena; ver README) al arrancar
# con Docker, o en modo desarrollo con: python -m scripts.demo. Un telefono
# simulado muestra su codigo de verificacion en dos pasos. La pantalla de
# inicio no lista cuentas y la seguridad funciona igual. SOLO funciona con
# MODO_DATOS=sinteticos; para otra empresa: MODO_DEMO=no y MODO_DATOS=reales.
MODO_DEMO=no
DEMO_CONTRASENA=Nordika-2026

# --- Reportes exportados (paso 9) ---
# Zona horaria de las fechas en el PDF y la presentacion.
ZONA_HORARIA=America/Mexico_City

# --- Avisos y programacion mensual (paso 10) ---
# La API revisa al arrancar y cada PROGRAMACION_CADA_MINUTOS si hay indicadores
# nuevos en rojo y, si RRHH activo la programacion en Configuracion, genera los
# reportes del mes. Pon PROGRAMACION_EN_API=no si solo usas el Programador de
# tareas (python -m scripts.programar).
PROGRAMACION_EN_API=si
PROGRAMACION_CADA_MINUTOS=60

# Correo OPCIONAL para avisar "tienes N avisos nuevos" con la liga al sistema.
# Nunca lleva datos de RRHH. Vacio = sin correo (los avisos se ven en el tablero).
# Gmail: SMTP_HOST=smtp.gmail.com, puerto 587 y una contrasena de aplicacion
# (myaccount.google.com/apppasswords; requiere verificacion en 2 pasos).
# Nunca uses tu contrasena normal. SMTP_REMITENTE vacio = SMTP_USUARIO.
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=
# Direccion del tablero web que va en el correo (Docker: http://localhost:8080)
APP_URL=http://localhost:5173

# --- Respaldos (python -m scripts.respaldo) ---
# Carpeta de los respaldos (por defecto respaldos/ en la raiz del proyecto) y
# cuantos conservar. Con datos reales, ponla en un disco cifrado.
# RESPALDOS_DIR=D:\Respaldos\Talentia
# RESPALDOS_CONSERVAR=30
# Contenedores de docker compose (solo si les cambiaste el nombre)
# DB_CONTENEDOR=rrhh_db
# API_CONTENEDOR=rrhh_api

# --- Base de datos en la nube (Supabase) ---
# Si DATABASE_URL tiene valor, se usa en lugar del PostgreSQL local de Docker.
# En Supabase: boton "Connect" > "Session pooler" (funciona en redes IPv4).
# Cambia [YOUR-PASSWORD] por la contrasena de la base. SSL se activa solo.
# Las pruebas (pytest) se niegan a correr contra una base remota.
# DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
