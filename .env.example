# Configuracion de Talentia Insights. Copia este archivo a .env y llena lo que
# vas a usar: el .env lleva tus contrasenas y nunca se sube a GitHub.
#
# Para la demostracion con Docker basta con cambiar cuatro lineas de la parte 1:
#   POSTGRES_PASSWORD, MODO_DATOS=sinteticos, MODO_DEMO=si y DEMO_CONTRASENA.
# Luego: docker compose up -d --build  y abre http://localhost:8080
#
# El archivo tiene dos partes:
#   1. OBLIGATORIO: lo usa siempre el sistema. Revisa cada valor.
#   2. OPCIONAL: Groq, correo, red de la empresa, respaldos y Supabase. Si no
#      los usas, dejalos vacios o comentados (con #): no hacen nada.


# ==========================================================================
#  1. OBLIGATORIO
# ==========================================================================

# --- Base de datos (PostgreSQL en Docker) ---
POSTGRES_USER=rrhh_user
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=rrhh_motor

# --- Datos ---
# MODO_DATOS: "reales" (por defecto) bloquea cualquier IA en la nube.
# Pon "sinteticos" SOLO si la base tiene los datos de prueba (scripts/seed.py).
MODO_DATOS=reales
# Nombre de la empresa (pantalla de inicio, menu y reportes).
EMPRESA_NOMBRE=Nordika Logística

# --- Modo demostracion ---
# Con MODO_DEMO=si se crean las cuentas de prueba del personal de Nordika al
# arrancar con Docker (los usuarios salen en: docker compose logs api), o en
# modo desarrollo con: python -m scripts.demo. Un telefono simulado muestra su
# codigo de verificacion en dos pasos. La pantalla de inicio no lista cuentas y
# la seguridad funciona igual. SOLO funciona con MODO_DATOS=sinteticos; para
# otra empresa: MODO_DEMO=no y MODO_DATOS=reales.
MODO_DEMO=no
# Contrasena de todas las cuentas de prueba (minimo 10 caracteres). Elige una
# tuya: sin ella el modo demostracion no se activa.
DEMO_CONTRASENA=

# --- IA que redacta los reportes (la narrativa SIEMPRE la redacta un modelo) ---
# LLM_PROVEEDOR: ollama (local, unico permitido con datos reales) | groq (nube, parte 2)
LLM_PROVEEDOR=ollama
LLM_INTENTOS=3            # intentos con correccion por cada ronda
NARRATIVA_RONDAS=2        # rondas desde cero si el modelo no pasa los guardarrailes
# Ollama (local): instala ollama.com y corre  ollama pull qwen3:8b
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=900        # segundos; en CPU un reporte tarda minutos
OLLAMA_NUM_CTX=8192       # 4096 se rebasaba en los reintentos
# OLLAMA_THINK=false      # true deja que Qwen "piense" antes de responder: mas lento
# OLLAMA_URL=http://localhost:11434   # si Ollama corre en otro equipo de la red
# (con Docker, la API llega al Ollama de este equipo por host.docker.internal)

# --- Sesion y verificacion en dos pasos ---
# Secreto para firmar los tokens de sesion: minimo 32 caracteres, unico por
# instalacion. Generalo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Con Docker, si lo dejas vacio se genera uno temporal en cada arranque (las
# sesiones se cierran al reiniciar).
JWT_SECRETO=
JWT_MINUTOS=60            # duracion de la sesion
# Roles que deben usar verificacion en dos pasos (app de autenticacion en el
# telefono). Los demas pueden activarla si quieren. No lo vacies con datos reales.
MFA_OBLIGATORIO=direccion,admin_ti,rrhh
# Llave que cifra el secreto del MFA de cada cuenta (AES-256). Si la dejas vacia
# se genera sola la primera vez en llaves/mfa.key. Respaldala APARTE de la base:
# si se pierde, TI tiene que reiniciar la verificacion en dos pasos de todos.
# Para fijarla:
#   python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MFA_LLAVE=

# --- Reportes y programacion mensual ---
# Zona horaria de las fechas en el PDF y la presentacion.
ZONA_HORARIA=America/Mexico_City
# La API revisa al arrancar y cada PROGRAMACION_CADA_MINUTOS si hay indicadores
# nuevos en rojo y, si RRHH activo la programacion en Configuracion, genera los
# reportes del mes. Pon PROGRAMACION_EN_API=no si solo usas el Programador de
# tareas (python -m scripts.programar).
PROGRAMACION_EN_API=si
PROGRAMACION_CADA_MINUTOS=60


# ==========================================================================
#  2. OPCIONAL: dejalo vacio o comentado si no lo usas
# ==========================================================================

# --- Groq: IA en la nube, solo para demostraciones rapidas ---
# Gratis sin tarjeta: console.groq.com/keys. Solo funciona con
# MODO_DATOS=sinteticos y LLM_PROVEEDOR=groq; con datos reales esta bloqueado.
# Activa "Zero Data Retention" en console.groq.com > Settings > Data Controls.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TIMEOUT=120        # segundos
# GROQ_STRICT=true        # false si el modelo elegido no admite respuesta JSON estricta
# GROQ_URL=https://api.groq.com/openai/v1/chat/completions

# --- Correo de avisos (SMTP) ---
# Manda "tienes N avisos nuevos" con la liga al sistema. Nunca lleva datos de
# RRHH. Con SMTP_HOST vacio no se manda correo: los avisos se ven en el tablero.
# Gmail: SMTP_HOST=smtp.gmail.com, puerto 587 y una contrasena de aplicacion
# (myaccount.google.com/apppasswords; requiere verificacion en 2 pasos).
# Nunca uses tu contrasena normal. SMTP_REMITENTE vacio = SMTP_USUARIO.
# El certificado del servidor de correo se verifica: con uno autofirmado o de
# una autoridad interna no sale ningun correo (el motivo queda en el log).
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=
# Direccion del tablero que va en el correo (Docker: http://localhost:8080)
APP_URL=http://localhost:5173

# --- Red de la empresa (HTTPS) ---
# Por defecto la base, la API y el tablero solo aceptan conexiones de este
# mismo equipo. Para abrir el tablero a la red, pon aqui la IP del equipo.
# DB_ESCUCHA=127.0.0.1
# API_ESCUCHA=127.0.0.1
# WEB_ESCUCHA=127.0.0.1
# HTTPS del tablero: auto (por defecto) lo activa en cuanto WEB_ESCUCHA abre el
# tablero a la red; si = siempre; no = nunca (se niega si esta abierto a la red).
# Certificado de la empresa en certs/talentia.crt y certs/talentia.key; si no
# hay, se genera uno autofirmado para WEB_NOMBRE. Con HTTPS, APP_URL debe ser
# la direccion https (por ejemplo https://192.168.1.20:8443).
# WEB_HTTPS=auto
# WEB_NOMBRE=localhost
# WEB_PUERTO_HTTPS=8443

# --- Conexion a la base (solo si cambiaste el puerto o el equipo) ---
# DB_HOST=localhost
# DB_PORT=5433            # docker-compose.yml publica el 5433
# DB_CONNECT_TIMEOUT=5    # segundos para rendirse si la base no responde

# --- Respaldos (python -m scripts.respaldo) ---
# Carpeta de los respaldos (por defecto respaldos/ en la raiz del proyecto) y
# cuantos conservar. Con datos reales, ponla en un disco cifrado.
# RESPALDOS_DIR=D:\Respaldos\Talentia
# RESPALDOS_CONSERVAR=30
# Contenedores de docker compose (solo si les cambiaste el nombre)
# DB_CONTENEDOR=rrhh_db
# API_CONTENEDOR=rrhh_api

# --- Base de datos en la nube (Supabase), solo con datos sinteticos ---
# Si DATABASE_URL tiene valor, se usa en lugar del PostgreSQL local de Docker.
# En Supabase: boton "Connect" > "Session pooler" (funciona en redes IPv4).
# Cambia [YOUR-PASSWORD] por la contrasena de la base. SSL se activa solo.
# Las pruebas (pytest) se niegan a correr contra una base remota.
# DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
